<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately empty.

  From API 31 the platform draws its own splash from the launch theme, and the
  icon slot it offers is masked to a circle — which is the wrong shape for a
  wordmark and would crop "omaykan" to "may". Handing it nothing leaves a plain
  brand-coloured window that the app's own splash then paints the wordmark onto,
  so the two read as one screen instead of a basket followed by a logo.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
