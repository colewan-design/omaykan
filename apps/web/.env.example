# --- Backend + realtime -----------------------------------------------------
# Base URL the Laravel API calls resolve against. Blank falls back to
# VITE_ONLINE_ORDER_API_BASE, then to the origin serving the app.
VITE_API_BASE=
VITE_ONLINE_ORDER_API_BASE=
# Laravel Reverb websocket the browser subscribes to for live order updates.
# Must match the backend REVERB_* values; blank falls back to polling.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_REVERB_PATH=
# Leave blank unless you intentionally want one build pinned to one tenant.
VITE_POS_ORGANIZATION_SLUG=
VITE_POS_STORE_CODE=
# The one tenant that may show the bundled demo catalog when its real catalog
# cannot be loaded. Blank means no tenant may, which is what a live shop wants:
# demo products carry slug ids that no order can be priced against, so a shopper
# who adds one reaches "Place order" and is turned away. Set this to the demo
# org's slug while showing the product off; clear it to take the demo shelf
# down everywhere.
VITE_POS_DEMO_ORG_SLUG=
# Shown to storefront customers who choose pickup at checkout.
VITE_POS_STORE_ADDRESS=123 Market Street, Downtown
# Business mode the public storefront (store.html) sells for — one of
# coffee-shop | grocery | restaurant. Nail salon has no online storefront.
VITE_POS_BUSINESS_MODE=coffee-shop
# --- Sign in with Google -----------------------------------------------------
# The *Web* OAuth client id from Google Cloud Console — the same value the
# backend gets as GOOGLE_CLIENT_ID. Blank means the storefront ships no Google
# script and shows no Google button; email and password sign-in is unaffected.
# The origin this build is served from must be listed as an Authorised
# JavaScript origin on that client, or the button renders and then refuses.
# See documentation/google-sign-in.md.
VITE_GOOGLE_CLIENT_ID=

VITE_POS_DEVICE_NAME=Front Counter
VITE_POS_APP_VERSION=0.1.0

# --- Live delivery map -------------------------------------------------------
# Mapbox public access token (pk.*). Used by the customer's tracking view and
# the merchant dashboard to draw where the rider is. This is a *public* token
# and is compiled into the browser bundle by design — that is what pk tokens
# are for — so restrict it to your own domains under "URL restrictions" in the
# Mapbox account, and never put a secret (sk.*) token here.
# Blank means no map: every screen falls back to the stage text it showed
# before, which is a supported state and not an error.
VITE_MAPBOX_TOKEN=
# The style the map draws with. Any Mapbox style URL works; the default is the
# standard street map, which is the one riders and customers can read fastest.
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

# The domain every shop gets a subdomain of: <slug>.omaykan.com. The link the
# till's Settings hands out uses it, and a page served on one of those hosts
# opens that shop. Blank falls back to /shop/<slug> on the serving origin,
# which is what a laptop or a preview build wants. Needs the wildcard DNS
# record, a *.omaykan.com certificate and the nginx server block — see
# documentation/deployment.md.
VITE_SHOP_ROOT_DOMAIN=
