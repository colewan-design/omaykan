# Production build environment for apps/web.
#
# VITE_* values are compile-time constants inlined into the bundle: a wrong
# value here cannot be fixed on the server, only by rebuilding. Keep this file
# in step with .env.production.example, which is the committed record.
#
# Every key the app reads must be listed here, not just the ones that differ
# from the defaults. Vite layers .env.production OVER .env, so any key this
# file omits is inherited from the developer's local .env — which is how a
# build can silently ship http://127.0.0.1 as its API base.

# Blank: the web deployment is served from the same origin as /api.
VITE_API_BASE=
VITE_ONLINE_ORDER_API_BASE=

# Must match REVERB_APP_KEY in the server's backend/.env. Reverb binds to
# localhost on :8081 and is reached through the nginx /reverb/ proxy, so the
# browser needs the public host and that path — not the bind address.
VITE_REVERB_APP_KEY=<must match the backend .env REVERB_APP_KEY>
VITE_REVERB_HOST=omaykan.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_REVERB_PATH=/reverb

# The tenant this storefront shows. A blank slug is a release blocker: it
# makes every catalog request a 422 and renders an empty shop.
VITE_POS_ORGANIZATION_SLUG=sm
VITE_POS_STORE_CODE=main
VITE_POS_BUSINESS_MODE=grocery
VITE_POS_STORE_ADDRESS=SM City Baguio, Luneta Hill, Baguio

# The store's own pin, matching the stores row in the production database.
# Delivery is quoted from here.
VITE_POS_STORE_LAT=16.4095
VITE_POS_STORE_LNG=120.5995

# Blank: no tenant may fall back to the bundled demo shelf. Those products
# carry slug ids no order can be priced against.
VITE_POS_DEMO_ORG_SLUG=

# The Web OAuth client id, matching the backend's GOOGLE_CLIENT_ID. Blank hides
# the Google button entirely. See documentation/google-sign-in.md.
VITE_GOOGLE_CLIENT_ID=

VITE_POS_DEVICE_NAME=Front Counter
VITE_POS_APP_VERSION=0.1.0

# --- Live delivery map -------------------------------------------------------
# Mapbox public access token (pk.*), compiled into the bundle by design. Add
# this deployment's domains under the token's URL restrictions in the Mapbox
# account. Blank means no map and the stage text alone, which still works.
VITE_MAPBOX_TOKEN=
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

# --- Features waiting on a backend release (src/commerce/features.ts) -------
# "false" hides a feature whose API is not deployed yet. Delete the line once
# the backend that serves it is live.
VITE_FEATURE_MESSAGES=false
VITE_FEATURE_RIDER_RATING=false

# The domain every shop gets a subdomain of: <slug>.omaykan.com. The link the
# till's Settings hands out uses it, and a page served on one of those hosts
# opens that shop. Blank falls back to /shop/<slug> on the serving origin,
# which is what a laptop or a preview build wants. Needs the wildcard DNS
# record, a *.omaykan.com certificate and the nginx server block — see
# documentation/deployment.md.
VITE_SHOP_ROOT_DOMAIN=omaykan.com
