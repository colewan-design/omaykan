# Production build for omaykan.com. nginx serves the SPA and /api from the same
# origin, so the API base stays blank and every call is relative.
VITE_API_BASE=
VITE_ONLINE_ORDER_API_BASE=

# Reverb, reached through the nginx /reverb proxy (see sites-available/omaykan).
# Key must match the backend's REVERB_APP_KEY.
VITE_REVERB_APP_KEY=<must match the backend .env REVERB_APP_KEY>
VITE_REVERB_HOST=omaykan.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_REVERB_PATH=/reverb

# The tenant this storefront sells for. Blank here is what emptied the shelves:
# fetchCatalog sends orgSlug=&storeCode= and the API answers 422.
VITE_POS_ORGANIZATION_SLUG=sm
VITE_POS_STORE_CODE=main
VITE_POS_BUSINESS_MODE=grocery
VITE_POS_STORE_ADDRESS=SM City Baguio, Luneta Hill, Baguio

# Blank on purpose: demo products carry slug ids no order can be priced
# against, so they must never reach a real shopper.
VITE_POS_DEMO_ORG_SLUG=

VITE_POS_DEVICE_NAME=Front Counter
VITE_POS_APP_VERSION=0.1.0
