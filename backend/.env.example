APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Where the customer storefront is served from. Order mail links to its
# tracking page. Defaults to APP_URL + /store, which is how it is mounted when
# both ship from the same host — set it explicitly if they are split.
STOREFRONT_URL="${APP_URL}/store"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=colepos
DB_USERNAME=colepos
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. `log` writes messages to storage/logs instead of sending them, which is
# what you want locally. To send for real, point MAIL_MAILER=smtp at the host
# for info@omaykan.com and fill in the credentials below — they are the
# mailbox's own, so they belong in .env, never in this file or in git.
#
# Three addresses, three jobs: FROM is the mailbox we send through, REPLY_TO is
# the one customers are told to write to, ALERTS is where "someone signed up"
# lands. They can all be the same mailbox; they are separate keys so that
# changing the sender doesn't move the published support address.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@omaykan.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="support@omaykan.com"
MAIL_ALERTS_ADDRESS="info@omaykan.com"

# The inbox that receives mail sent to support@omaykan.com. The platform admin
# portal reads this over IMAP to show incoming mail and send threaded replies.
# Leave blank locally unless you have a real mailbox and the PHP IMAP extension.
SUPPORT_INBOX_HOST=
SUPPORT_INBOX_PORT=993
SUPPORT_INBOX_USERNAME=
SUPPORT_INBOX_PASSWORD=
SUPPORT_INBOX_MAILBOX=INBOX
SUPPORT_INBOX_ENCRYPTION=ssl
SUPPORT_INBOX_VALIDATE_CERT=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb (websockets). Generate real values per environment with
# `php artisan reverb:install` or by hand — never reuse these.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# On the VPS these point at the public host, proxied over TLS:
# REVERB_HOST="api.example.ph"
# REVERB_PORT=443
# REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
